<?xml version="1.0" encoding="utf-8"?>
<!-- Icône adaptative Gestion : le corgi de la page web Gestion.
     Fond = la couleur du fond de l'image d'origine (#FBFCFB,
     moyenne de ses coins) ; premier plan = le corgi à 75 % du
     canevas, pour que sa silhouette entière (oreilles comprises)
     reste dans le cercle inscrit, quel que soit le masque du
     lanceur. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
