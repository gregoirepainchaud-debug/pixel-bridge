<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- Le paquet d'installation téléchargé par la mise à jour
         intégrée vit dans le cache de l'app, puis est effacé.
         C'est le seul usage de FileProvider dans l'app : les
         sessions de reçus sont copiées dans Documents/scans/
         mais ne sont jamais partagées par ce canal (les deux
         chemins « scans » d'avant le retrait de l'onglet
         Scanner ont été retirés en 0.18). -->
    <cache-path name="maj" path="maj/" />
</paths>
