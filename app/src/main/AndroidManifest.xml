<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pipeline local : aucun accès réseau requis pour capter,
         transcrire ou extraire. INTERNET ne sert qu'à la synchro. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Textos : Gestion Android lit les textos reçus et les
         pousse au pont (filigrane local, permission demandée à
         l'exécution dans l'onglet Textos). -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Oreille robuste : le service d'écoute est un service
         d'avant-plan de type micro (capture qui survit à l'écran
         fermé/éteint) ; le verrou de réveil partiel empêche le
         processeur de s'endormir pendant une longue écoute. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Suivi de trajet natif (0.16) : localisation précise +
         arrière-plan (le service d'avant-plan type location
         capte écran fermé), Bluetooth pour le signal de l'auto.
         GrapheneOS sans Play services : LocationManager natif
         seulement. Permissions accordées par Grégoire sur le
         Pixel ; l'onglet Réglages montre l'état de chacune et
         guide vers « Autoriser tout le temps ». -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Mise à jour intégrée : l'app télécharge le dernier build
         et lance son propre installateur (bouton « Mettre à jour »
         dans l'onglet Réglages de Gestion). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".GestionApp"
        android:icon="@mipmap/ic_launcher"
        android:label="Gestion"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <!-- Gestion Android : l'écran de lancement. Quatre
             onglets (Gestion en WebView, Oreille, Textos,
             Réglages) depuis 0.17 — l'onglet Tuner et l'onglet
             Scanner général ont été retirés (apps autonomes).
             Le scanner de reçus ML Kit, lancé depuis la page
             Reçus de la WebView, roule dans Play Services :
             aucune permission CAMERA n'est déclarée pour lui.
             RECORD_AUDIO sert à l'Oreille. -->
        <activity
            android:name=".GestionActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Écran Oreille (bouton unique on/off, design de
             Grégoire 2026-11-17) : lancé par l'onglet Oreille de
             Gestion et par la tuile du panneau de réglages
             rapides. singleTask : la tuile ramène l'instance
             existante plutôt que d'en empiler une. -->
        <activity
            android:name=".oreille.OreilleActivity"
            android:exported="false"
            android:launchMode="singleTask" />

        <!-- Service d'écoute robuste : la séance (capture,
             transcription, correction, envoi au pont) vit ici, en
             avant-plan type micro, pilotée par la tuile, l'écran
             Oreille ou le bouton de sa propre notification. -->
        <service
            android:name=".oreille.OreilleService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Tuile « Oreille » des réglages rapides : un tap
             démarre le service d'écoute, un autre l'arrête et
             l'envoie — sans ouvrir l'écran (repli sur l'écran si
             le système refuse le démarrage). -->
        <service
            android:name=".oreille.OreilleTileService"
            android:exported="true"
            android:icon="@android:drawable/ic_btn_speak_now"
            android:label="Oreille"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Suivi de trajet natif (0.16) : service d'avant-plan
             type location, notification discrète. En veille, il
             ne tient aucun abonnement de position — dormance
             complète, réveil événementiel seulement (capteur de
             mouvement significatif, Bluetooth de l'auto). -->
        <service
            android:name=".gps.GpsService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Relance du suivi au démarrage de l'appareil. -->
        <receiver
            android:name=".gps.GpsDemarrageReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
